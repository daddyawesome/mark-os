# Copy this file to .env for local development. Never commit the real .env.
# MARK OS does not load it automatically; pass it to Uvicorn with:
# uvicorn --env-file .env app.main:app --reload

MARK_OS_USERNAME=mark
MARK_OS_PASSWORD=

# Required on Railway. Generate a value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional locally. Railway should use the mounted persistent-volume path.
# MARK_OS_DB_PATH=data/mark_os.db

# Phase 6.2 backup settings. On Railway, keep this inside /app/data.
# MARK_OS_BACKUP_DIR=data/backups
# MARK_OS_BACKUP_PREFIX=mark_os
# MARK_OS_BACKUP_KEEP_LAST=14
# MARK_OS_BACKUP_MAX_AGE_HOURS=26

# Phase 6.5 operations monitoring.
# Use the public Railway URL ending in /health.
# MARK_OS_HEALTH_URL=https://your-service.up.railway.app/health
# MARK_OS_HEALTH_TIMEOUT_SECONDS=10
# Optional free Discord-compatible Owner alert. Treat the real URL as a secret.
# MARK_OS_OWNER_ALERT_WEBHOOK_URL=
